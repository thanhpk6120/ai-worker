# Copy sang .env rồi điền giá trị thật. Không commit file .env.
# Quy tắc: biến có sẵn trong process.env giữ nguyên, .env chỉ điền chỗ thiếu.
# Đơn vị thời gian: DEFAULT_TIMEOUT tính bằng giây, SYSTEMONE_TIMEOUT_MS/CACHE_TTL_MS tính bằng mili-giây.

# Cổng HTTP của dashboard + API ai-worker. Mặc định 3000.
PORT=3000
# Số job chạy song song trong TaskQueue. Mặc định 3. Tăng lên nếu máy khỏe, giảm xuống nếu CLI agent nặng.
CONCURRENCY=3
# Timeout mặc định cho mỗi lượt CLI agent (giây). Mặc định 900 = 15 phút. Áp dụng khi job không khai timeout riêng.
DEFAULT_TIMEOUT=900
# Số vòng FIXING tối đa cho 1 job trước khi đánh FAILED. FixGate Jev cũng tôn trọng ngưỡng này (attempt>=max là dừng).
MAX_FIXING_RETRIES=3
# Thư mục gốc chứa worktree git cho từng workspace. Bỏ comment để ghi đè đường mặc định ./worktrees.
# WORKTREE_BASE_DIR=./worktrees
# Thư mục ghi log pipeline. Bỏ comment để ghi đè đường mặc định ./logs.
# LOG_DIR=./logs
# Thư mục ghi evidence đối soát. Bỏ comment để ghi đè đường mặc định ./evidence.
# EVIDENCE_DIR=./evidence
# Bật/tắt toàn bộ nhánh SystemOne. true = gọi Jev trước điểm spawn CLI, false = chạy CLI-only như cũ (kill-switch, không cần restart code).
SYSTEMONE_ENABLED=true
# URL riêng cho SystemOne — KHÁC HOÀN TOÀN với URL LLM của agent CLI.
# Đây là endpoint typed-decision /v1/systemone của gateway 9router, tách riêng khỏi /v1/completion của LLM.
# Client POST thẳng vào URL này, cấm nối thêm path. Đổi sang self-host khác khi cần.
# Mặc định trong code = self-host local (http://127.0.0.1:20128/v1/systemone); không hardcode domain vào source.
SYSTEMONE_BASE_URL=https://9router.thanhpk.io.vn/v1/systemone
# Model typed-decision dùng cho 6 quyết định. Prefix "openrouter/" là provider routing của 9router.
# Đã probe live 2026-10-21: HTTP 200, provider "TypeSafe", model typesafe/jev-1.13-20260917.
# Lưu ý: bỏ prefix "openrouter/" sẽ ra 400 "No credentials for provider: typesafe".
SYSTEMONE_MODEL=openrouter/typesafe/jev-1.13
# Timeout mỗi request Jev (ms). Phải nhỏ hơn DEFAULT_TIMEOUT để không treo job. Khuyến nghị 8000.
SYSTEMONE_TIMEOUT_MS=8000
# Thời gian sống của cache quyết định Jev trong RAM (ms). Cùng payload đã scrub thì lần 2 ăn cache, không gọi mạng. Mặc định 3600000 = 1 giờ.
SYSTEMONE_CACHE_TTL_MS=3600000
# API key cho SystemOne. Gửi qua header Authorization: Bearer.
# Bắt buộc có thì Jev mới trả 200, thiếu/sai thì 401 và pipeline fallback đường cũ.
# Lưu ý: key hiện tại trong .env là key 9router dùng chung với LLM (ANTHROPIC_AUTH_TOKEN).
# Tách thật: tạo key riêng trên dashboard 9router rồi gán vào đây.
SYSTEMONE_API_KEY=

# --- AI Triage (phân loại độ phức tạp task) ---
# Triage gọi 1 lượt headless AI (claude CLI) để đo độ phức tạp task, trả JSON.
# Kill-switch RIÊNG cho nhánh CLI này (độc lập SYSTEMONE_ENABLED là kill-switch gateway Jev).
# Tắt (false) => triage rơi về heuristic offline (confidence <= 0.4 => KHÔNG tự bật chế độ NHANH).
AI_TRIAGE_ENABLED=true
# Timeout cho 1 lượt gọi AI triage (ms). Độc lập timeout của job (user khai).
# Mặc định 30000. Tăng nếu máy chậm; không nên > 60000 (chặn Start task).
AI_TRIAGE_TIMEOUT_MS=30000
# Thời gian sống cache kết quả triage trong RAM (ms). Mặc định 3600000 = 1 giờ.
AI_TRIAGE_CACHE_TTL_MS=3600000
# Timeout bắt tay MCP (ms). Ai-worker truyền cho claude/omp qua mergedEnv (MCP_TIMEOUT/MCP_HANDSHAKE_TIMEOUT + OMP_MCP_TIMEOUT_MS tương thích). Mặc định 60000.
MCP_HANDSHAKE_TIMEOUT_MS=60000
# Bật/tắt tool-search MCP (true/false). Mặc định false. Truyền qua ENABLE_TOOL_SEARCH cho claude/omp.
# Model cho claude CLI, truyền qua flag --model. Bắt buộc dùng flag vì env ANTHROPIC_MODEL
# trong ~/.claude/settings.json của CLI đè lên process env, đổi qua shell không có tác dụng.
# Ví dụ: claude-opus-5, claude-sonnet-5, opus[1m]. Để trống = dùng model mặc định của máy.
CLAUDE_MODEL=
